# UniMap Acceptance Fixture Environment
# Copy to .env and fill in actual values. NEVER commit .env to Git.

# Bearer token for all control API endpoints (choose a strong random string)
FIXTURE_CONTROL_TOKEN=change-me-to-a-random-token

# Server's public IP address (used for DNS reset)
FIXTURE_PUBLIC_IP=132.232.231.41

# Private/loopback IP for DNS flip (default: 127.0.0.1)
FIXTURE_PRIVATE_IP=127.0.0.1

# Cloudflare API token (Zone.DNS edit permission)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Cloudflare zone ID for the target domain
CLOUDFLARE_ZONE_ID=your-zone-id

# Full DNS record name to flip (e.g. rebind.target.example.com)
CLOUDFLARE_RECORD_NAME=rebind.target.example.com
