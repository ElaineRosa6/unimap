# UniMap webhook -> SMTP email relay configuration.
# Copy this file to .env and fill in real values. Never commit the .env file
# (it holds the SMTP authorization code / password).

# SMTP server (QQ Mail: smtp.qq.com, port 465 implicit SSL)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465

# Sender mailbox (required)
SMTP_USER=your-sender@qq.com
# SMTP credential (required). For QQ this is the SMTP authorization code,
# NOT the QQ login password.
SMTP_PASSWORD=your-app-password-or-authorization-code

# Recipient mailbox(es), comma-separated (required)
MAIL_TO=recipient@example.com

# Optional presentation
MAIL_FROM_NAME=UniMap
MAIL_SUBJECT_PREFIX=[UniMap]

# Listen address for the webhook receiver
RELAY_LISTEN=0.0.0.0:8099
# Optional bearer token; when set, POST /webhook must send X-Relay-Token.
RELAY_TOKEN=
